# Supabase Configuration
# Optional in local evaluation (app automatically uses resilient demo storage if empty)
# Set these in Vercel project settings or .env.local for production Supabase connection:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Direct PostgreSQL connection string for Drizzle migrations
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
